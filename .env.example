# ── Database ──────────────────────────────────────────────────────────────────
# Migrations run as the owner; the app connects as a role that CANNOT bypass RLS.
DATABASE_URL="postgresql://groundwork_app:dev_app_pw@localhost:5432/groundwork_dev"
MIGRATION_DATABASE_URL="postgresql://groundwork_owner:dev_owner_pw@localhost:5432/groundwork_dev"

# ── Gemini ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=""
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
CHAT_MODEL="gemini-2.5-flash"

# ── Auth ──────────────────────────────────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ── Server ────────────────────────────────────────────────────────────────────
PORT="3000"
NODE_ENV="development"

# The worker drains the job queue across tenants; scoped by policy, not by bypass.
WORKER_DATABASE_URL="postgresql://groundwork_worker:dev_worker_pw@localhost:5432/groundwork_dev"

# Resolves an anonymous widget visitor's public key to its organization. Scoped
# by policy to widget_keys only (see migration 0006) — not a general bypass.
PUBLIC_DATABASE_URL="postgresql://groundwork_public:dev_public_pw@localhost:5432/groundwork_dev"
